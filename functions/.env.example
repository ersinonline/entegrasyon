# Encryption key for storing sensitive credentials (32 characters)
ENCRYPTION_KEY=your-32-character-encryption-key

# Firebase Config (otomatik alınır, manuel override için)
# FIREBASE_PROJECT_ID=teknotech-app

# Development/Production mode
NODE_ENV=development

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Job settings
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY_MS=5000

# Marketplace API endpoints (production)
N11_API_BASE_URL=https://api.n11.com
TRENDYOL_API_BASE_URL=https://api.trendyol.com/sapigw
HEPSIBURADA_API_BASE_URL=https://mpop-sit.hepsiburada.com
PAZARAMA_API_BASE_URL=https://isortagimapi.pazarama.com
IDEFIX_API_BASE_URL=https://merchantapi.idefix.com
